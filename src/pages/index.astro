---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import StingButton from '../components/StingButton.astro';
import { games, studio } from '../data/games';

const year = new Date().getFullYear();
---

<Layout>
  <div class="mx-auto flex min-h-dvh w-full max-w-3xl flex-col px-6">
    <header class="flex flex-col items-center pb-12 pt-16 text-center sm:pt-20">
      <div class="flex items-center justify-center gap-3 sm:gap-4">
        <img
          src="/favicon.svg"
          alt=""
          width="40"
          height="40"
          class="h-9 w-9 shrink-0 sm:h-10 sm:w-10"
          aria-hidden="true"
        />
        <h1
          class="text-[1.75rem] font-bold leading-none tracking-[0.2em] text-ink sm:text-4xl"
        >
          {studio.wordmark}
        </h1>
      </div>
      <p class="mt-4 text-base text-muted sm:text-lg">{studio.tagline}</p>
    </header>

    <main class="flex-1 pb-16">
      <h2 class="sr-only">Games</h2>
      <ul class="grid grid-cols-1 gap-10 sm:grid-cols-2 sm:gap-x-8 sm:gap-y-12">
        {
          games.map((game) => (
            <li>
              <GameCard game={game} />
            </li>
          ))
        }
      </ul>
    </main>

    <footer
      class="flex flex-col items-center gap-3 py-10 text-center text-sm text-muted"
    >
      <p>{studio.name} · {year}</p>
      <StingButton />
    </footer>
  </div>
</Layout>
