---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import StingButton from '../components/StingButton.astro';
import { games, studio } from '../data/games';

const year = new Date().getFullYear();
const aboutParts = studio.about.split(studio.authorName);
const linkClass =
  'font-semibold text-ink underline decoration-1 underline-offset-2 outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink';
---

<Layout>
  <div class="mx-auto flex min-h-dvh w-full max-w-3xl flex-col px-6">
    <header class="flex flex-col items-center pb-12 pt-16 text-center sm:pt-20">
      <div class="flex items-center justify-center gap-3 sm:gap-4">
        <img
          src="/favicon.svg"
          alt=""
          width="40"
          height="40"
          class="h-9 w-9 shrink-0 sm:h-10 sm:w-10"
          aria-hidden="true"
        />
        <h1
          class="text-[1.75rem] font-bold leading-none tracking-[0.2em] text-ink sm:text-4xl"
        >
          {studio.wordmark}
        </h1>
      </div>
      <p class="mt-4 text-base text-muted sm:text-lg">{studio.tagline}</p>
      <p class="mt-5 max-w-3xl text-base text-ink">{studio.intro}</p>
    </header>

    <main class="flex-1 pb-8">
      <section>
        <h2 class="mb-8 font-semibold">Games</h2>
        <ul class="grid grid-cols-1 gap-12 sm:grid-cols-2 sm:gap-x-8 sm:gap-y-14">
          {
            games.map((game) => (
              <li>
                <GameCard game={game} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-16 mb-8">
        <h2 class="mb-4 font-semibold">About</h2>
        <p class="text-base leading-relaxed text-ink">
          {aboutParts[0]}<a
            href={studio.authorUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={linkClass}>{studio.authorName}</a
          >{aboutParts.slice(1).join(studio.authorName)}
        </p>
      </section>
    </main>

    <footer
      class="flex flex-col items-center gap-3 py-10 text-center text-sm text-muted"
    >
      <p>
        {studio.name} · <a
          href={studio.authorUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={linkClass}>{studio.authorName}</a
        > · {year}
      </p>
      <StingButton />
      <p>
        <a
          href={studio.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={linkClass}>{studio.sourceLabel}</a
        >
      </p>
    </footer>
  </div>
</Layout>
